package views

import( 
	"isydia.music/model"
 	"strings"
)

// This module contains components common to most pages.
/*

from the <html><head><body></body></head></html>,
to smaller

*/

// 404 Page
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/syaksa.css"/>
		</head>
		@NavBar()
		<body class="procyon_b rift">
			<header></header>
			<br/>
			<div class="body-text">
				@OpenDataStream03()
				<h1>...you've found a <a>Rift</a> in space...</h1>
				{ children... }
				@CloseDataStream03()
			</div>
			<footer></footer>
		</body>
	</html>
}

templ BasicText(text string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ "「⌞ ⁂ ⌝」" }</title>
			<link rel="stylesheet" href="/static/syaksa.css"/>
		</head>
		@NavBar()
		<body>
			<header></header>
			<br/>
			<div class="body-text">
				@OpenDataStream03()
				<p>{ text }</p>
				{ children... }
				@CloseDataStream03()
			</div>
			<footer></footer>
		</body>
	</html>
}

templ IsydiaLayout(collections []*model.Album) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ "Isydia" }</title>
			<link rel="stylesheet" href="/static/syaksa.css"/>
		</head>
		<body class={"collection-page isydia"}>
			@NavBar()
			<header>
				<h1><a href="/isydia">{ "Isydia" }</a></h1>
			</header>
			<br/>
			<div class="body-text">
				@OpenDataStream02()

				for _, collection := range collections {
					@NarrativeTable(collection.AlbumName, collection.Narratives)
				}

				@CloseDataStream01()
				{ children... }
			</div>
			<footer>
			</footer>
		</body>
	</html>
}

templ ProcyonLayout(collections []*model.Album) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ "Procyon B" }</title>
			<link rel="stylesheet" href="/static/syaksa.css"/>
		</head>
		<body class={"collection-page procyon_b"}>
			@NavBar()
			<header>
				<h1><a href="/procyon_b">{ "Procyon B" }</a></h1>
			</header>
			<br/>
			<div class="body-text">
				@OpenDataStream02()

				for _, collection := range collections {
					@NarrativeTable(collection.AlbumName, collection.Narratives)
				}

				@CloseDataStream01()
